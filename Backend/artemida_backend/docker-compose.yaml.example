services:
  postgres:
    image: pgvector/pgvector:pg17
    container_name: artemida-postgres
    restart: unless-stopped

    environment:
      POSTGRES_USER: YOU_USER
      POSTGRES_PASSWORD: YOU_DB_PASSWORD
      POSTGRES_DB: artemida
    networks:
      - pg-network
    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data
  pgadmin:
    image: dpage/pgadmin4
    ports:
      - "5050:80"
    environment:
      PGADMIN_DEFAULT_EMAIL: EMAIL_FOR_pgAdmin
      PGADMIN_DEFAULT_PASSWORD: PASSWORD_FOR_pgAdmin
    networks:
      - pg-network
  redis:
    image: redis:latest
    container_name: redis_artemida
    ports:
        - '6379:6379'
    volumes:
        - redis-data:/data
    environment:
        - REDIS_ARGS=--requirepass PASSWORD_FOR_Redis --appendonly yes
    restart: unless-stopped
networks:
  pg-network:
    driver: bridge
volumes:
  postgres_data:
  redis-data:
    driver: local