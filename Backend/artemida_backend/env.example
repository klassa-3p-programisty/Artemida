NODE_ENV="development" # "development" or "production"

APP_HOST_NAME_PROD="..."  # production host(domen) name
APP_HOST_NAME_DEV="localhost" # development base host(domen) name

APP_PORT=3000 #application api port

DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/artemida" #conection link to db for prisma ORM

REDIS_HOST_NAME_DEV="localhost"
REDIS_HOST_NAME_PROD="..."
REDIS_PORT=6379
REDIS_PASSWORD="..." #must match the Redis requirepass value in docker-compose.yaml
SESSION_SECRET="..."
SALT=10

ENTITY_NUMBER_ON_DASHBOARD=5 #number of entities in dashboard shortcast info 