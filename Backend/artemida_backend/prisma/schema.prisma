// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TEST {
  testID Int @id @default(autoincrement())
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  TESTER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum GradingMode {
  GROUP
  INDIVIDUAL
}

enum ConversationType {
  DIRECT
  GROUP
}

enum NotificationType {
  NEW_ASSIGNMENT
  GRADE_RECEIVED
  NEW_MESSAGE
  DEADLINE_REMINDER
  ASSIGNMENT_NOTE
  ADMIN_MESSAGE
  PASSWORD_RECOVERY
}

enum PasswordResetStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum CalendarEventType {
  PERSONAL
  SCHOOL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  GRADE_CHANGE
}

enum AssignmentType {
  INDIVIDUAL
  GROUP
}

enum GroupFormationMode {
  STUDENT
  TEACHER
}

enum GradeValue {
  G1       @map("1")
  G1_PLUS  @map("1+")

  G2_MINUS @map("2-")
  G2       @map("2")
  G2_PLUS  @map("2+")

  G3_MINUS @map("3-")
  G3       @map("3")
  G3_PLUS  @map("3+")

  G4_MINUS @map("4-")
  G4       @map("4")
  G4_PLUS  @map("4+")

  G5_MINUS @map("5-")
  G5       @map("5")
  G5_PLUS  @map("5+")

  G6_MINUS @map("6-")
  G6       @map("6")
}


model User {
  id Int @id @default(autoincrement())

  role   Role       @default(STUDENT)
  status UserStatus @default(PENDING)

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  name            String
  surname         String
  description     String?
  profileImageUrl String? @default("https://res.cloudinary.com/dcknki3cq/image/upload/v1794601192/user.png")
  email           String? @unique

  login              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  notifications           Notification[]
  conversationMemberships ConversationMember[]
  sentMessages            Message[]
  calendarEvents          CalendarEvent[]
  passwordResetRequests   PasswordResetRequest[] @relation("PasswordResetOwner")
  processedPasswordResets PasswordResetRequest[] @relation("PasswordResetAdmin")

  sessions  UserSession[]
  auditLogs AuditLog[]
}

model StudentProfile {
  public_id String @id @default(uuid(7))
  userId    Int    @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Student-specific fields
  classId                    Int?
  student_class              SchoolClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissionMemberships      SubmissionMember[]
  grades                     Grade[]
  assignmentGroupMemberships AssignmentGroupMember[]
}

model SchoolClass {
  id Int @id @default(autoincrement())

  // student StudentProfile @relation(fields: [student_id], references: [userId], onDelete: Cascade)
  name        String              @unique
  students    StudentProfile[]
  assignments TeacherAssingment[]
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId Int    @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Teacher-specific fields
  specialization  String?
  assignments     TeacherAssingment[]
  grades          Grade[]
  assignmentNotes AssignmentNote[]
  gradeHistory    GradeHistory[]
}

model TeacherAssingment {
  id Int @id @default(autoincrement())

  teacherId String
  classId   Int
  subjectId Int

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  schoolClass SchoolClass    @relation(fields: [classId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  assignments Assignment[]

  @@unique([teacherId, classId, subjectId])
}

model Subject {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  assingments TeacherAssingment[]
}

model Assignment {
  id Int @id @default(autoincrement())

  title               String
  description         String?
  deadline            DateTime
  teacherAssignmentId Int
  status              AssignmentStatus       @default(DRAFT)
  teacherAssignment   TeacherAssingment      @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  createAt            DateTime               @default(now())
  updateAt            DateTime               @updatedAt
  attachment          AssignmentAttachment[]
  notes               AssignmentNote[]
  gradingMode         GradingMode            @default(INDIVIDUAL)
  type                AssignmentType         @default(INDIVIDUAL)
  groupFormationMode  GroupFormationMode?
  groups              AssignmentGroup[]
  submission          Submission[]
}

model AssignmentAttachment {
  id Int @id @default(autoincrement())

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  storageKey String?  @unique
  fileName   String
  fileUrl    String
  fileSize   Int
  fileType   String
  createdAt  DateTime @default(now())
}

model AssignmentNote {
  id Int @id @default(autoincrement())

  assignmentId Int
  teacherId    String

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([teacherId])
}

model AssignmentGroup {
  id Int @id @default(autoincrement())

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  name        String?
  members     AssignmentGroupMember[]
  createdAt   DateTime                @default(now())
  submissions Submission[]

  @@index([assignmentId])
}

model AssignmentGroupMember {
  id Int @id @default(autoincrement())

  groupId   Int
  studentId String
  group     AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student   StudentProfile  @relation(fields: [studentId], references: [public_id], onDelete: Restrict)

  joinedAt DateTime @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Submission {
  id Int @id @default(autoincrement())

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  versions            SubmissionVersion[]
  members             SubmissionMember[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  groupId             Int?
  group               AssignmentGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  resubmissionAllowed Boolean             @default(false)

  @@index([assignmentId])
}

model SubmissionVersion {
  id Int @id @default(autoincrement())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  version     Int
  content     String?
  submittedAt DateTime         @default(now())
  files       SubmissionFile[]
  grades      Grade[]

  @@unique([submissionId, version])
}

model SubmissionFile {
  id Int @id @default(autoincrement())

  submissionVersionId Int
  submissionVersion   SubmissionVersion @relation(fields: [submissionVersionId], references: [id], onDelete: Restrict)

  storageKey String?  @unique
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  @@index([submissionVersionId])
}

model SubmissionMember {
  id Int @id @default(autoincrement())

  submissionId Int
  studentId    String

  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [studentId], references: [public_id], onDelete: Restrict)
  joinedAt   DateTime       @default(now())

  @@unique([submissionId, studentId])
  @@index([studentId])
}

model Grade {
  id Int @id @default(autoincrement())

  submissionVersionId Int
  studentId           String
  teacherId           String

  submissionVersion SubmissionVersion @relation(fields: [submissionVersionId], references: [id], onDelete: Restrict)
  student           StudentProfile    @relation(fields: [studentId], references: [public_id], onDelete: Restrict)
  teacher           TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  value GradeValue?
  points     Float?
  percentage Float?
  comment    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  history    GradeHistory[]

  @@unique([submissionVersionId, studentId])
  @@index([studentId])
  @@index([teacherId])
}

model GradeHistory {
  id Int @id @default(autoincrement())

  gradeId   Int
  teacherId String
  grade     Grade          @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  oldValue GradeValue?
  newValue GradeValue?
  oldPoints     Float?
  newPoints     Float?
  oldPercentage Float?
  newPercentage Float?
  reason        String?
  changedAt     DateTime @default(now())
  oldComment    String?
  newComment    String?

  @@index([gradeId, changedAt])
  @@index([teacherId])
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Conversation {
  id Int @id @default(autoincrement())

  type      ConversationType     @default(DIRECT)
  title     String?
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ConversationMember {
  id Int @id @default(autoincrement())

  conversationId Int
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  senderId       Int

  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  content         String?
  replyToId       Int?
  replyTo         Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]           @relation("MessageReplies")
  forwardedFromId Int?
  forwardedFrom   Message?            @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[]           @relation("MessageForwards")
  attachments     MessageAttachment[]
  isDeleted       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id Int @id @default(autoincrement())

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Restrict)

  storageKey String   @unique
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  @@index([messageId])
}

model AuditLog {
  id BigInt @id @default(autoincrement())

  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model UserSession {
  id String @id @default(uuid())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model CalendarEvent {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  title       String
  description String?
  type        CalendarEventType @default(PERSONAL)
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, startsAt])
}

model PasswordResetRequest {
  id Int @id @default(autoincrement())

  userId  Int
  adminId Int?
  user    User  @relation("PasswordResetOwner", fields: [userId], references: [id], onDelete: Restrict)
  admin   User? @relation("PasswordResetAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  status       PasswordResetStatus @default(PENDING)
  reason       String?
  adminComment String?
  createdAt    DateTime            @default(now())
  processedAt  DateTime?
  completedAt  DateTime?

  @@index([userId, status])
  @@index([adminId])
}
