// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TEST{
  testID Int @id @default(autoincrement())
}


enum Role{
  ADMIN
  TEACHER
  STUDENT
  TESTER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model User{

  id Int @id @default(autoincrement())

  role Role @default(STUDENT) 
  status UserStatus @default(PENDING)

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?


  name String 
  surname String 
  description String?
  profileImageUrl String? @default("https://res.cloudinary.com/dcknki3cq/image/upload/v1794601192/user.png")
  email String? @unique

  login String @unique 
  passwordHash String


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}


model StudentProfile {
  public_id        String @id @default(uuid(7))
  userId    Int @unique

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Student-specific fields
  classId       Int?
  student_class SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
}

model SchoolClass{
  id         Int @id @default(autoincrement())
  student_id Int @unique

  // student StudentProfile @relation(fields: [student_id], references: [userId], onDelete: Cascade)
  students StudentProfile[]
  teachers TeacherProfile[]
  assignments TeacherAssingment[]

}

model TeacherProfile {
  id        String @id @default(uuid())
  userId    Int @unique

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Teacher-specific fields
  specialization String?
  classes SchoolClass[]
  assignments TeacherAssingment[]
}

model TeacherAssingment {
  id Int @id @default(autoincrement())

  teacherId String
  classId Int
  subjectId Int

  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  assignments Assignment[]
  @@unique([teacherId, classId, subjectId])
}

model Subject {
  id    Int @id @default(autoincrement())
  name  String @unique
  assingments TeacherAssingment[]
}

model Assignment {
  id Int @id @default(autoincrement())

  title String
  description String?
  deadline DateTime
  teacherAssignmentId Int
  status AssignmentStatus @default(DRAFT)
  teacherAssignment  TeacherAssingment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  attachment AssignmentAttachment[]
}

model AssignmentAttachment {
  id Int @id @default(autoincrement())

  assignmentId Int
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName String
  fileUrl String
  fileSize Int
  createdAt DateTime @default(now())
  
}
